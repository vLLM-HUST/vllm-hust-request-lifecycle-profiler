# Non-secret NPU6 baseline server profile for lifecycle trace readiness.
# Keep API tokens in the caller shell or vLLM-HUST dev-hub .env; do not add them here.

VLLM_ENGINE_SYSTEMD_UNIT=codex-vllm-request-lifecycle-profiler-npu6.service
VLLM_ENGINE_CONTAINER=codex-vllm-request-lifecycle-profiler-npu6
VLLM_ENGINE_PORT=18168
VLLM_ENGINE_NPU_DEVICES=6
ASCEND_RT_VISIBLE_DEVICES=6
ASCEND_VISIBLE_DEVICES=6

VLLM_ENGINE_TP_SIZE=1
VLLM_ENGINE_MODEL_PATH=/data/shared_models/Qwen2.5-7B-Instruct
VLLM_ENGINE_SERVED_MODEL_NAME=codex-qwen2.5-7b-npu6
VLLM_ENGINE_MAX_MODEL_LEN=4096
VLLM_ENGINE_MAX_NUM_BATCHED_TOKENS=4096
VLLM_ENGINE_MAX_NUM_SEQS=4
VLLM_ENGINE_GPU_MEM_UTIL=0.75

VLLM_ENGINE_ENABLE_PREFIX_CACHING=1
VLLM_ENGINE_ENABLE_CHUNKED_PREFILL=1
VLLM_ENGINE_ENFORCE_EAGER=0
VLLM_ENGINE_COMPILATION_CONFIG={"cudagraph_mode":"FULL_DECODE_ONLY","cudagraph_capture_sizes":[1,2,4],"max_cudagraph_capture_size":4}
VLLM_ENGINE_EXTRA_ARGS_JSON=["--additional-config","{\"ascend_compilation_config\":{\"fuse_norm_quant\":false,\"fuse_qknorm_rope\":false,\"fuse_allreduce_rms\":false,\"fuse_muls_add\":false}}"]
VLLM_ENGINE_EXTRA_ENV_KEYS=VLLM_RLP_TRACE_EXPORT_PATH,VLLM_RLP_TRACE_ENABLED
VLLM_ENGINE_EXTRA_ENV_PREFIXES=VLLM_RLP_
VLLM_OPTIMIZATION_REPO_CONTAINER=/workspace/vllm-request-lifecycle-profiler-plugin
VLLM_ENGINE_PYTHONPATH=/workspace/vllm-request-lifecycle-profiler-plugin/src:/workspace/vllm-request-lifecycle-profiler-plugin:/workspace/vllm-request-lifecycle-profiler-plugin/third_party/vllm-hust:/workspace/vllm-ascend-hust
VLLM_ENGINE_CONTAINER_LOG_FILE=/tmp/codex-vllm-request-lifecycle-profiler-npu6.redacted.log

VLLM_RLP_ENDPOINT=http://127.0.0.1:18168
VLLM_RLP_MODEL_PATH=/data/shared_models/Qwen2.5-7B-Instruct

VLLM_PLUGINS=ascend
COMPILE_CUSTOM_KERNELS=1
TORCH_DEVICE_BACKEND_AUTOLOAD=0
VLLM_ASCEND_TORCH_PREFLIGHT=0
VLLM_USE_SIMPLE_KV_OFFLOAD=0
